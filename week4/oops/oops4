#include<iostream>
using namespace std;

class Test{
public:
    virtual int square(int)=0;
};


class Arithmetic:public Test{

public:

int square(int n){
    return n*n;
}

};


class ToTestInt{

public:

void test(){

Arithmetic a;

cout<<"Square = "<<a.square(5);

}

};


int main(){

ToTestInt t;

